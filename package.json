{
  "name": "song-workshop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "brand:check": "amezquita-brand check tokens/brands/song-workshop --pairs tokens/brands/song-workshop/contrast-pairs.json",
    "brand:build": "amezquita-brand build tokens/brands/song-workshop --out styles/brand --pairs tokens/brands/song-workshop/contrast-pairs.json",
    "dev": "npm run brand:build && next dev",
    "build": "npm run brand:build && next build",
    "serve": "node scripts/serve-out.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@amezquita/design-system": "1.7.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "style-dictionary": "5.8.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
